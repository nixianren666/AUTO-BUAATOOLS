[Unit]
Description=AUTO-BUAA Course Signin Pro Web Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/auto-buaa
ExecStart=/usr/bin/python3 run.py --headless --host 0.0.0.0 --port 18346
Restart=always
RestartSec=5
Environment=HEADLESS=1
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
