# Documentation template only; install via scripts/install_linux_service.sh.
# Generated user unit is ~/.config/systemd/user/buaa-signin.service.
[Unit]
Description=AUTO-BUAA user service
After=network.target
[Service]
Type=simple
ExecStart=/absolute/project/.venv/bin/python /absolute/project/run.py --headless --host 127.0.0.1
Restart=always
RestartSec=5
[Install]
WantedBy=default.target
